# Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────────
# Database (MongoDB Atlas / Local)
# ─────────────────────────────────────────────
# Set DB_STORAGE_TYPE to 'mongodb' when connecting to MongoDB Atlas
DB_STORAGE_TYPE=in_memory
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.e6m50ew.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=asm_shield_db


# ─────────────────────────────────────────────
# Cache (Redis) — configured in later phases
# ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Scanner Defaults — override per scanner in later phases
# ─────────────────────────────────────────────
DEFAULT_SCAN_TIMEOUT_SECONDS=10
DEFAULT_MAX_CONCURRENT_SCANS=5
